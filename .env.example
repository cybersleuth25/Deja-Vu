# Hindsight (Cloud: copy the API URL and key from your Hindsight console; self-hosted: e.g. http://localhost:8888)
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
DEJAVU_BANK=dejavu-prod

# Groq (optional: without a key the narrative uses a template that still cites incident ids)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: force the offline memory backend even when HINDSIGHT_BASE_URL is set
# DEJAVU_MEMORY=mock
